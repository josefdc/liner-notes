{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Measured.schema.json",
    "type": "object",
    "properties": {
      "field": {
        "type": "string",
        "minLength": 1,
        "description": "e.g. 'tempo', 'key', 'loudness', 'style:Synth-pop'"
      },
      "value": { "type": ["number", "string"] },
      "unit": {
        "description": "e.g. 'bpm'; null for unitless values such as a key",
        "type": ["string", "null"]
      },
      "confidence": {
        "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
      },
      "method": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "minLength": 1,
            "description": "Estimator, or the model id when basis is 'model'"
          },
          "analyzerVersion": { "type": "string", "minLength": 1 }
        },
        "required": ["algorithm", "analyzerVersion"]
      },
      "window": { "type": "string", "const": "preview-30s" },
      "basis": { "type": "string", "enum": ["signal", "model"] }
    },
    "required": ["field", "value", "unit", "confidence", "method", "window", "basis"]
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Measured.schema.json",
    "type": "object",
    "properties": {
      "field": {
        "type": "string",
        "minLength": 1,
        "description": "e.g. 'tempo', 'key', 'loudness', 'style:Synth-pop'"
      },
      "value": { "type": ["number", "string"] },
      "unit": {
        "description": "e.g. 'bpm'; null for unitless values such as a key",
        "type": ["string", "null"]
      },
      "confidence": {
        "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }]
      },
      "method": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "minLength": 1,
            "description": "Estimator, or the model id when basis is 'model'"
          },
          "analyzerVersion": { "type": "string", "minLength": 1 }
        },
        "required": ["algorithm", "analyzerVersion"],
        "additionalProperties": false
      },
      "window": { "type": "string", "const": "preview-30s" },
      "basis": { "type": "string", "enum": ["signal", "model"] }
    },
    "required": ["field", "value", "unit", "confidence", "method", "window", "basis"],
    "additionalProperties": false
  },
  "unknownKeys": { "$": "strip", "$.method": "strip" },
  "refinements": [],
  "tolerant": []
}
