{
  "name": "liner-notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "services/audio",
    "packages/contract"
  ],
  "scripts": {
    "dev": "exec node scripts/dev.mjs",
    "build": "npm run build -w packages/contract -w apps/web -w apps/api",
    "test:db": "npm run test:db -w apps/api",
    "preview": "npm run preview -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "guard:honest": "node scripts/guard-honest.mjs"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
