# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# =============================================================================
# LANGUAGE MODELS (provider layer, src/llm)
# =============================================================================

# Provider: "azure" (default). "gemini" is not implemented yet and refuses every call.
# LLM_PROVIDER=azure

# Azure OpenAI resource and key. The key is sent in a request header and never logged.
# Calls use the v1 API of the resource: AZURE_OPENAI_ENDPOINT is the resource root and
# "openai/v1/" is appended (unless it already ends with /openai/v1). AZURE_OPENAI_BASE_URL, when
# set, is used as the v1 base URL instead; a query on it (e.g. ?api-version=preview) is sent
# with every request. AZURE_OPENAI_API_VERSION is accepted but not used: the v1 API takes none.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment per tier. Each call site asks for a tier: fast (scout, classification, research
# planner), main (composer), research (summaries), judge (verifier). For each tier the first
# variable set wins:
#   fast      AZURE_OPENAI_DEPLOYMENT_FAST, else gpt-6-luna
#   main      AZURE_OPENAI_DEPLOYMENT_MAIN, else AZURE_OPENAI_DEPLOYMENT_FAST, else gpt-6-luna
#   research  AZURE_OPENAI_DEPLOYMENT_RESEARCH, else AZURE_OPENAI_DEPLOYMENT_PRO, else gpt-6-sol
#   judge     AZURE_OPENAI_DEPLOYMENT_JUDGE, else AZURE_OPENAI_DEPLOYMENT_PRO, else gpt-6-sol
# A deployment that is not in src/llm/prices.ts is counted at USD 10 / 40 per 1M tokens x 1.5.
# AZURE_OPENAI_DEPLOYMENT_FAST=gpt-6-luna
# AZURE_OPENAI_DEPLOYMENT_PRO=gpt-6-sol
# AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-6-luna
# AZURE_OPENAI_DEPLOYMENT_RESEARCH=gpt-6-sol
# AZURE_OPENAI_DEPLOYMENT_JUDGE=gpt-6-sol

# Spend log: an absolute path (or ~/...) of a JSONL file outside the repository, shared by every
# process, checkout and test database (a symlink to it shares its lock; hard links are not
# supported). Each live call appends a reservation line before it runs and a settle line after
# it; the caps below apply to the sum of the file. While it is unset, missing, or cannot be read or written, live calls are refused.
# A missing log is never taken as "nothing spent": create it once with
#   npm run smoke:llm -w apps/api -- --init
# A malformed line refuses every call until fixed; the layer never cuts a line it did not
# write. If a power loss tore the last line, move it aside (its length is printed) with
#   npm run smoke:llm -w apps/api -- --repair-tail
# LLM_SPEND_LOG=~/.local/state/liner-notes/llm-spend.jsonl

# Budget caps in USD, over everything in the spend log. The daily cap counts each call on the
# UTC day it was reserved (the day ends at 19:00 in Bogota). Development and showcase calls stop
# once total spending passes BUDGET_TOTAL_USD - BUDGET_EVAL_FLOOR_USD. The floor is not set aside:
# evaluation spending counts towards the total too, so it moves that point closer. Each eval
# sub-purpose (eval:golden, eval:baseline, eval:perturb, eval:variance) has its own cap; plain
# "eval" may spend the floor but has no sub-cap, so prefer a sub-purpose.
# BUDGET_TOTAL_USD=25
# BUDGET_DAILY_USD=13.5
# BUDGET_EVAL_FLOOR_USD=20
# BUDGET_EVAL_GOLDEN_USD=13
# BUDGET_EVAL_BASELINE_USD=2.5
# BUDGET_EVAL_PERTURB_USD=1
# BUDGET_EVAL_VARIANCE_USD=3.5

# Limits: timeout of one attempt (ms), model calls per analysis run (retries included), calls
# in flight at once per process.
# LLM_TIMEOUT_MS=90000
# MAX_LLM_CALLS_PER_RUN=12
# LLM_CONCURRENCY=2

# Cassettes (tests and evals only; refused when NODE_ENV=production): "record" saves each live
# answer, "replay" answers from saved ones with no network and no spending (a missing one is
# an error), "off" (default) neither. Tests replay by default.
# LLM_CASSETTE=off
# LLM_CASSETTE_DIR=./cassettes/llm

# Source cassettes (tests and evals only; refused when NODE_ENV=production): the same modes for
# the music and search sources and the audio service. Recorded answers are scrubbed (no keys, no
# preview or image URLs). SOURCE_CASSETTE_DIR is where they live (default: apps/api/cassettes).
# The audio step is filed by track (ISRC, else Spotify id), analyzer version and window, never by
# the preview clip: what was measured, or why nothing was (no clip, an unfinished lookup, the
# service unavailable, a refusal), with recorded text kept free of links. Its replay asks neither
# Deezer for a clip nor the audio service, gives no preview URL and never reads the audio cache;
# an entry of another analyzer version is a miss, never served in its place. A directory holds
# one /health (the analyzer of its latest recording): after an analyzer change, earlier entries
# are misses, so re-record the whole set into a fresh directory. Recording measures every track
# again, even one the audio cache holds.
# SOURCE_CASSETTE=off
# SOURCE_CASSETTE_DIR=

# Purpose of every model call of this process (the spend log's "unit", and the cap it counts
# against), for an evaluation harness that starts the API: eval:golden, eval:baseline,
# eval:perturb or eval:variance. Unset: dev. Any other value stops the API at startup, and so
# does any value with REPLAY_MODE=only or outside development and tests (NODE_ENV development or
# test, or unset under `npm run dev`).
# LLM_RUN_PURPOSE=eval:golden

# LangChain/LangSmith tracing (LANGSMITH_TRACING, LANGSMITH_TRACING_V2, LANGCHAIN_TRACING_V2,
# LANGCHAIN_TRACING) sends prompts and answers to a tracing service; live model calls are
# refused while it is on, unless this is set to 1. They are also refused while
# OPENAI_CUSTOM_HEADERS is set (headers the OpenAI client would add to every request), and
# OPENAI_LOG, OPENAI_BASE_URL and the other OPENAI_* settings are ignored.
# LLM_ALLOW_TRACING=

# Tavily API Key (for web search)
# Get from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# NEW TOOL INTEGRATIONS
# =============================================================================

# User-Agent sent with every request to the music and search sources (optional). The default
# names the app and its repository. Set it to identify your own deployment, as
# AppName/Version ( contact ), where contact is a URL or an email address. MUSICBRAINZ_USER_AGENT
# is read when it is not set; older copies of this file set it to a placeholder: delete that line.
# SOURCE_USER_AGENT=

# Last.fm API Key (strongly recommended — enriches genre profile and discovery)
# Get from https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Primary-record sources (optional). A source without its credential is reported as missing;
# nothing is guessed in its place. Each credential is sent in a request header, never in a URL.
# Discogs personal access token (https://www.discogs.com/settings/developers), sent as
# "Authorization: Discogs token=...". Used for release credits.
# DISCOGS_TOKEN=
# SecondHandSongs API key, sent as "X-API-Key". Optional: without it requests are anonymous and
# limited to a lower rate.
# SHS_API_KEY=
# Genius client access token (https://genius.com/api-clients), sent as "Authorization: Bearer ...".
# Only song relationships (samples, covers, remixes) are read; lyrics are never requested.
# GENIUS_ACCESS_TOKEN=

# Audio Analysis Microservice URL
# Run: cd services/audio && uvicorn main:app --port 3002
# GET /api/ready probes its /health (2 s timeout, the answer reused for 5 s).
AUDIO_ANALYSIS_URL=http://localhost:3002

# Server Configuration
PORT=3001
# Address to bind. The default 127.0.0.1 keeps the API off the network; containers set 0.0.0.0.
# HOST=127.0.0.1
# Probes: GET /api/health is liveness (200 while the process answers; what container health
# checks use). GET /api/ready is readiness: 200 when the API can serve what it is set up to
# serve, 503 otherwise, with each check's name, ok, status and reason: the database (open and
# writable), its migrations, the audio service (ok, degraded without its models, or
# unreachable), the model provider (configured, not_configured or invalid; what is missing is
# logged at warn by variable name, never shown) and the budget's state (available, exhausted,
# unverifiable or not_live; never an amount). When live analysis is not served
# (REPLAY_MODE=only, or fallback while live analysis is off or paused) the audio service and the
# provider are "not_needed": recorded runs and stored results are served. With REPLAY_MODE=off
# an exhausted or unverifiable budget answers 503; in fallback it answers 200. The route is
# public and limited per address like search (SEARCH_RATE_LIMIT_*).

# Log (optional). The API writes one JSON object per line to stdout; every line of an analysis
# carries its run id ("runId"), and each graph node's run is one line with its duration
# (component "Graph": node, runId, durationMs, and outcome ok, error, interrupted, cancelled
# when the run was cancelled, or aborted when LangGraph stopped the node because another node
# of the step failed). Configured keys and tokens, the model endpoint and preview links are
# scrubbed from what is written (a best effort over known values and patterns); client
# addresses (a keyed hash, "ipHash", instead), query strings, User-Agent and Referer are not
# written; what a visitor typed is written at debug level only.
# LOG_LEVEL: fatal, error, warn, info (default), debug, trace or silent.
# LOG_FILE: also append the lines to this file (no rotation). A relative path is taken from
# apps/api; the file is created readable by its owner only, and anything but a regular file is
# refused. To check one run:
#   LOG_FILE=data/api.jsonl npm run dev -w apps/api   # then run an analysis, and
#   grep -c '"runId"' apps/api/data/api.jsonl
# Without it, capture stdout instead (every level, errors included, goes to stdout):
#   npm start -s -w apps/api | tee apps/api/data/api.jsonl
# LOG_IP_SALT: the key of the address hash. Unset, each process picks a random one, so one
# address hashes alike only within one process.
# LOG_LEVEL=info
# LOG_FILE=
# LOG_IP_SALT=

# Replay mode (optional): "off" (default), "fallback" or "only".
#   off       every analysis is live.
#   fallback  live when possible; when live analysis is unavailable, the showcase tracks are
#             served from their recorded runs and other queries get an error: live_disabled
#             when no Spotify keys are set or LLM_SPEND_LOG cannot be used (unset, missing,
#             unreadable or locked: a fallback deployment needs its spend log created first),
#             budget_exhausted once the model budget is spent (a run of USD 0.54 would pass
#             BUDGET_TOTAL_USD, BUDGET_DAILY_USD or the evaluation floor). Search suggestions
#             and "more facts" fall back the same way. GET /api/replays lists the recorded
#             tracks.
#   only      recorded runs only: no Spotify, model or source call is ever made, and no key is
#             required. A query that is not a recorded track gets live_disabled, never another
#             track's recording.
# A replayed run says so: its result reads mode "replay", with when and from which commit it
# was recorded.
# REPLAY_MODE=only
# Directory of the recorded runs (fixtures/replays/<slug>.json, written by
# `npm run replay:record -w apps/api`). Default: fixtures/replays at the repository root.
# REPLAY_DIR=

# Browser origins allowed to call the API (CORS), comma-separated, each scheme://host[:port].
# Unset in development: the web dev ports 3000, 3100, 3110, 3120, ..., 3190 (the worktree slots,
# not the range between them), 4173 and WEB_PORT, each on localhost and 127.0.0.1.
# Write an origin as the browser sends it: no path, no trailing slash, no default port (:80, :443).
# Unset in production: none. Set but empty: none, with a warning at startup.
# Paid routes (analysis, factoids, search) and POST /api/runs also refuse requests from unlisted
# origins and cross-site requests with no Origin (403 forbidden_origin; in the stream for event
# streams). A request a browser marks Sec-Fetch-Site: same-origin passes whatever its Origin, but
# browsers that send no Sec-Fetch-Site (Safari before 16.4) send the page's Origin on a POST: list
# the site's own origin too when the web app is served from the API's origin.
# deploy/compose.prod.yml does not read this file: it requires CORS_ORIGINS in deploy/.env.
# CORS_ORIGINS=http://localhost:3000,https://liner-notes.example

# Run tokens. Analysis and factoid requests carry a short-lived token from POST /api/runs, which
# checks a Cloudflare Turnstile answer first. RUN_TOKEN_SECRET signs the tokens: at least 32
# bytes (for example `openssl rand -base64 48`); required in production, and a random key per
# process in development. TURNSTILE_SECRET_KEY is the widget's secret key: required in
# production. TURNSTILE_EXPECTED_HOSTNAME, when set, must match the hostname Turnstile reports.
# When NODE_ENV is development or test (or unset under `npm run dev`) and no
# TURNSTILE_SECRET_KEY is set, the answer "dev-bypass" is accepted; TURNSTILE_BYPASS=0 turns that
# off. Any other NODE_ENV needs both secrets, and TURNSTILE_BYPASS=1 there stops the API at startup.
# RUN_TOKEN_SECRET=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=liner-notes.example
# TURNSTILE_BYPASS=0

# Development and tests only: hold a replayed stream open this many milliseconds (with
# heartbeats) before its first event. Refused outside development and test.
# SSE_HOLD_MS=0

# Reverse proxies in front of the API whose X-Forwarded-For is trusted for the client address
# (the rate-limit key). 0 (default) when clients connect directly; 1 behind one proxy.
# TRUST_PROXY=0

# Rate limits. Analysis and factoids (paid model calls) share a per-IP limit and a limit across
# all clients over the same window; search has its own per-IP limit, and GET /api/ready one
# of the same size, counted apart.
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_MAX=30
# RATE_LIMIT_GLOBAL_MAX=300
# SEARCH_RATE_LIMIT_WINDOW_MS=60000
# SEARCH_RATE_LIMIT_MAX=60

# SQLite Database Path (optional, defaults to data/sonic-agent.db in apps/api).
# Run one API process per database file: at startup and shutdown a process records the runs
# still marked running as ended, taking them to be its own.
# A relative path is resolved against apps/api, not the directory the server is started from.
# SQLITE_DB_PATH=./data/sonic-agent.db

# Retention (optional). The API prunes old data at startup and then every hour.
# Checkpoints of a thread are deleted once it has been idle this many hours (minimum 1);
# a thread waiting for the user's track choice is kept until its run is older than RUN_RETENTION_DAYS.
# CHECKPOINT_RETENTION_HOURS=24
# Stored items (cached track results) not updated for this many days are deleted (minimum 1).
# STORE_RETENTION_DAYS=30
# Run records are deleted this many days after they finished, or started if they never did (minimum 1).
# Model usage rows (the database's copy of LLM_SPEND_LOG, read by `npm run report`) go with their
# run, or this many days after they were written when they belong to no run; the spend log is kept.
# RUN_RETENTION_DAYS=30
# The events a run's streams sent are deleted this many days after they were sent (minimum 1,
# never longer than RUN_RETENTION_DAYS); the run keeps its result.
# RUN_EVENT_RETENTION_DAYS=7
