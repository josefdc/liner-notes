# Only the install scripts listed under "allowScripts" in package.json may run;
# npm refuses any other (including a new version of a listed package) until it
# is reviewed and approved with `npm install-scripts approve <pkg>`. This also
# applies to npx inside the repository (use --allow-scripts=<pkg> for one-offs).
# Enforced by npm >= 11.18; older npm (e.g. npm 10) ignores the setting.
strict-allow-scripts=true
