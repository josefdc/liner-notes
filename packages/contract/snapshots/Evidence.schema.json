          "tavily"
        ]
      },
      "sourceTier": { "type": "string", "enum": ["primary-record", "editorial", "web"] },
      "url": { "type": ["string", "null"] },
      "title": { "type": "string" },
      "retrievedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "excerpt": { "type": "string" },
      "recordRef": {
        "description": "Id of the record at the source, e.g. a MusicBrainz MBID or a Discogs release id. A primary record's starts with its scope: track/ (this recording), release/ (a whole release the track is on) or work/ (the song, not this recording)",
        "type": ["string", "null"]
      }
    },
    "required": [
