# =============================================================================
# Docker Ignore - Frontend Build
# =============================================================================

# Dependencies
node_modules

# Build output
dist

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# Environment files (will be set via docker-compose)
.env*
!.env.example

# Documentation (not needed in container)
*.md
!README.md

# Logs
*.log
npm-debug.log*

# Test files
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__

# Server directory (has its own Dockerfile)
server
