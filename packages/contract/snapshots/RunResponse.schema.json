              },
              { "type": "null" }
            ]
          }
        },
        "required": ["id", "status", "mode", "spotifyId", "createdAt", "finishedAt"]
      },
      "analysis": { "anyOf": [{ "$ref": "TrackAnalysis.schema.json" }, { "type": "null" }] }
    },
    "required": ["success", "run", "analysis"]
  },
