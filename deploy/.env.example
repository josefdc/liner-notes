# Settings for deploy/compose.prod.yml. Copy to deploy/.env (never committed), make it readable
# by its owner only, and fill it in:
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# Compose reads this file for the ${...} values in compose.prod.yml; the containers receive only
# the variables that file passes on, which are all listed here. Values are taken literally: no
# quotes are needed.
#
# Not passed on, on purpose: settings for tests and evaluations (LLM_CASSETTE*, SOURCE_CASSETTE*,
# SSE_HOLD_MS, TURNSTILE_BYPASS, BUDGET_EVAL_*_USD), tracing (LANGSMITH_*, LANGCHAIN_*,
# LLM_ALLOW_TRACING, OPENAI_CUSTOM_HEADERS), and what the images fix (HOST, PORT, NODE_ENV,
# TRUST_PROXY, SQLITE_DB_PATH, LLM_SPEND_LOG, REPLAY_DIR, AUDIO_ANALYSIS_URL; LOG_FILE, since the
# containers' files are read-only: their log is stdout).

# -----------------------------------------------------------------------------
# Required: compose stops, naming the variable, while one of these is empty.
# -----------------------------------------------------------------------------

# Signs the run tokens: 32 bytes or more, e.g. the output of `openssl rand -base64 48`.
RUN_TOKEN_SECRET=
# The secret key of the Cloudflare Turnstile widget for the site's hostname.
TURNSTILE_SECRET_KEY=
# Shared by the API and the audio service (the audio service's /analyze requires it), e.g.
# `openssl rand -hex 32`.
AUDIO_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# The site
# -----------------------------------------------------------------------------

# Caddy's site address. Empty: ":80", plain HTTP (local use). A hostname (liner-notes.example)
# serves HTTPS on 443 and redirects port 80 to it; behind Cloudflare's proxy the certificate
# needs an Origin CA certificate or a DNS challenge (README, "Certificates"). Several hostnames
# are separated by ", ".
SITE_ADDRESS=
# Where the web service's ports are published. Defaults: 127.0.0.1, 3180 (HTTP) and 3181 (HTTPS).
# In production: PROXY_BIND=0.0.0.0, PROXY_PORT=80, PROXY_TLS_PORT=443.
PROXY_BIND=
PROXY_PORT=
PROXY_TLS_PORT=
# More proxy ranges, space-separated, whose CF-Connecting-IP is trusted besides Cloudflare's
# (apps/web/Caddyfile lists Cloudflare's). Empty: none.
TRUSTED_PROXIES=

# The images' names: <IMAGE_PREFIX>-web, -api and -audio, tagged IMAGE_TAG (defaults
# liner-notes and latest). A tag per release lets a deploy go back to the previous images.
IMAGE_PREFIX=
IMAGE_TAG=

# The web image's build settings (public: they ship in the page).
# The Turnstile widget's site key. Empty: the page sends the development bypass, which an API in
# production refuses.
VITE_TURNSTILE_SITE_KEY=
# Where the footer's "Source" link points. Empty: the public repository.
VITE_SOURCE_URL=

# -----------------------------------------------------------------------------
# The API (apps/api/.env.example describes each one)
# -----------------------------------------------------------------------------

# The hostname Turnstile must report for a solved challenge (the site's hostname).
TURNSTILE_EXPECTED_HOSTNAME=
# Key of the hashed client addresses in the API's log. Empty: a new key at each start.
LOG_IP_SALT=
# fatal, error, warn, info (default), debug, trace or silent.
LOG_LEVEL=
# Other origins allowed to call the API from a browser; the site itself needs none.
CORS_ORIGINS=
# fallback (default): live analysis when it can run, the recorded showcase runs when it cannot.
# off: live only. only: recorded runs only, no key needed.
REPLAY_MODE=

# Live analysis.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_DEPLOYMENT_FAST=
AZURE_OPENAI_DEPLOYMENT_PRO=
AZURE_OPENAI_DEPLOYMENT_MAIN=
AZURE_OPENAI_DEPLOYMENT_RESEARCH=
AZURE_OPENAI_DEPLOYMENT_JUDGE=
# Spending caps in USD (empty: the API's defaults).
BUDGET_TOTAL_USD=
BUDGET_DAILY_USD=
BUDGET_EVAL_FLOOR_USD=
# Model calls (empty: the API's defaults): the provider, one attempt's timeout in ms, calls per
# analysis run, calls in flight at once.
LLM_PROVIDER=
LLM_TIMEOUT_MS=
MAX_LLM_CALLS_PER_RUN=
LLM_CONCURRENCY=

# Sources (optional).
TAVILY_API_KEY=
LASTFM_API_KEY=
DISCOGS_TOKEN=
SHS_API_KEY=
GENIUS_ACCESS_TOKEN=
SOURCE_USER_AGENT=
# Read only when SOURCE_USER_AGENT is empty (older settings files).
MUSICBRAINZ_USER_AGENT=
# Timeout of one source request, in ms (empty: the default).
SOURCE_TIMEOUT_MS=

# Rate limits (empty: the API's defaults).
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
RATE_LIMIT_GLOBAL_MAX=
SEARCH_RATE_LIMIT_WINDOW_MS=
SEARCH_RATE_LIMIT_MAX=

# Retention (empty: the API's defaults).
CHECKPOINT_RETENTION_HOURS=
STORE_RETENTION_DAYS=
RUN_RETENTION_DAYS=
RUN_EVENT_RETENTION_DAYS=

# -----------------------------------------------------------------------------
# The audio service
# -----------------------------------------------------------------------------

# 0 skips the model download at start (the service runs without its perceptual features).
AUDIO_FETCH_MODELS=

# -----------------------------------------------------------------------------
# The development stack only (deploy/compose.dev.yml, project liner-notes-dev)
# -----------------------------------------------------------------------------

# Its Caddy's port on 127.0.0.1 (default 3182).
DEV_PROXY_PORT=
# Its API's REPLAY_MODE (default only: recorded runs, no paid call).
DEV_REPLAY_MODE=
