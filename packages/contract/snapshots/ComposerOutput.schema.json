{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ComposerOutput.schema.json",
    "type": "object",
    "properties": {
      "claims": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "description": "One factual statement about the track" },
            "about": {
              "type": "string",
              "enum": [
                "track",
                "credit",
                "sample",
                "cover",
                "history",
                "sound",
                "production",
                "connection",
                "trivia"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Ids of evidence items from the evidence pack that support this; [] when none"
            },
            "field": {
              "anyOf": [{ "type": "string", "enum": ["tempo", "key"] }, { "type": "null" }],
              "description": "'tempo' or 'key' when the statement gives the track's tempo or key; otherwise null"
            },
            "scope": {
              "type": "string",
              "enum": ["recording", "work", "release"],
              "description": "What the statement is about: 'recording' this recording of the track, 'work' the song whatever the recording (its writers, other artists' versions), 'release' a whole release the track is on (an album credit, the album it appears on)"
            }
          },
          "required": ["text", "about", "evidenceIds", "field", "scope"],
          "additionalProperties": false
        }
      },
      "factoids": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "Short title, no colon at the end" },
            "text": { "type": "string", "description": "One to three sentences" },
            "type": {
              "type": "string",
              "enum": ["production", "trivia", "credits", "sample", "curiosity", "connection"]
            },
            "entities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["synth", "producer", "sample", "technique", "artist", "album", "year"]
                  }
                },
                "required": ["text", "type"],
                "additionalProperties": false
              },
              "description": "Names in the text worth exploring (people, instruments, records, years)"
            },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Ids of evidence items from the evidence pack that support this; [] when none"
            },
            "scope": {
              "type": "string",
              "enum": ["recording", "work", "release"],
              "description": "What the statement is about: 'recording' this recording of the track, 'work' the song whatever the recording (its writers, other artists' versions), 'release' a whole release the track is on (an album credit, the album it appears on)"
            }
          },
          "required": ["title", "text", "type", "entities", "evidenceIds", "scope"],
          "additionalProperties": false
        },
        "description": "At most 8"
      },
      "genealogyNodes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Short unique id; 'current' for the analysed track"
            },
            "role": { "type": "string", "enum": ["current", "source", "derived", "influence"] },
            "label": { "type": "string", "description": "'Title - Artist (Year)'" },
            "trackTitle": { "type": ["string", "null"] },
            "trackArtist": { "type": ["string", "null"] },
            "year": { "type": ["string", "null"] }
          },
          "required": ["id", "role", "label", "trackTitle", "trackArtist", "year"],
          "additionalProperties": false
        }
      },
      "genealogyLinks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "description": "Node id of the earlier work: the record that is sampled, interpolated, covered, remixed or that influenced the target"
            },
            "target": {
              "type": "string",
              "description": "Node id of the later work: the record that uses or follows the source"
            },
            "type": {
              "type": "string",
              "enum": ["sample", "interpolation", "cover", "remix", "producer", "influence"]
            },
            "evidenceIds": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Ids of evidence items from the evidence pack that support this; [] when none"
            }
          },
          "required": ["source", "target", "type", "evidenceIds"],
          "additionalProperties": false
        }
      }
    },
    "required": ["claims", "factoids", "genealogyNodes", "genealogyLinks"],
    "additionalProperties": false
  },
  "output": {
