{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ReplayRecord.schema.json",
    "type": "object",
    "properties": {
      "version": { "type": "number", "const": 1 },
      "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "request": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "selectedTrackId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["query", "selectedTrackId"]
      },
      "recordedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "commit": { "type": "string", "minLength": 1 },
      "analyzerVersion": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "atMs": {
              "description": "Milliseconds since the stream opened",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "event": { "$ref": "AnalyzeStreamEvent.schema.json" }
          },
          "required": ["atMs", "event"]
        }
      },
      "analysis": { "$ref": "TrackAnalysis.schema.json" },
      "usage": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "llmCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "inputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "outputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "reasoningTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "usd": {
                "description": "Cost at the configured price table",
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["llmCalls", "inputTokens", "outputTokens", "reasoningTokens", "usd"]
          },
          { "type": "null" }
        ]
      }
    },
    "required": [
      "version",
      "slug",
      "request",
      "recordedAt",
      "commit",
      "analyzerVersion",
      "events",
      "analysis",
      "usage"
    ]
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ReplayRecord.schema.json",
    "type": "object",
    "properties": {
      "version": { "type": "number", "const": 1 },
      "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "request": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "selectedTrackId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["query", "selectedTrackId"],
        "additionalProperties": false
      },
      "recordedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
      },
      "commit": { "type": "string", "minLength": 1 },
      "analyzerVersion": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "atMs": {
              "description": "Milliseconds since the stream opened",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "event": { "$ref": "AnalyzeStreamEvent.schema.json" }
          },
          "required": ["atMs", "event"],
          "additionalProperties": false
        }
      },
      "analysis": { "$ref": "TrackAnalysis.schema.json" },
      "usage": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "llmCalls": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "inputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "outputTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "reasoningTokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              "usd": {
                "description": "Cost at the configured price table",
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["llmCalls", "inputTokens", "outputTokens", "reasoningTokens", "usd"],
            "additionalProperties": false
          },
          { "type": "null" }
        ]
      }
    },
    "required": [
      "version",
      "slug",
      "request",
      "recordedAt",
      "commit",
      "analyzerVersion",
      "events",
      "analysis",
      "usage"
    ],
    "additionalProperties": false
  },
  "unknownKeys": { "$": "strip", "$.request": "strip", "$.events[]": "strip", "$.usage": "strip" },
  "refinements": [
    "$: replay.analysis-run",
    "$: replay.complete-events-replay",
    "$: replay.event-order"
  ]
}
