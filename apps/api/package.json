{
  "name": "@liner-notes/api",
  "private": true,
  "version": "0.1.0",
  "description": "LangGraph backend for The Sonic Agent",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @liner-notes/contract",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build -w @liner-notes/contract",
    "start": "tsx src/index.ts",
    "pretest:db": "npm run build -w @liner-notes/contract",
    "test:db": "vitest run --root ../.. --project api src/store/database.test.ts",
    "pretest:lastfm": "npm run build -w @liner-notes/contract",
    "test:lastfm": "vitest run --root ../.. --project api src/sources/lastfm.test.ts",
    "prebuild": "npm run build -w @liner-notes/contract",
    "build": "tsup",
    "start:prod": "node dist/index.js",
    "pretypecheck": "npm run build -w @liner-notes/contract",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build -w @liner-notes/contract",
    "test": "vitest run --root ../.. --project api"
  },
  "dependencies": {
    "@google/genai": "1.34.0",
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/tavily": "1.2.0",
    "@liner-notes/contract": "0.0.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.19.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
