# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Google Gemini API Key (for LLM)
# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key (for web search)
# Get from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# NEW TOOL INTEGRATIONS
# =============================================================================

# MusicBrainz User-Agent (required for API access)
# Format: AppName/Version (contact-email)
MUSICBRAINZ_USER_AGENT=SonicAgent/1.0 (your-email@example.com)

# Last.fm API Key (strongly recommended — enriches genre profile and discovery)
# Get from https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Audio Analysis Microservice URL
# Run: cd services/audio && uvicorn main:app --port 3002
AUDIO_ANALYSIS_URL=http://localhost:3002

# Server Configuration
PORT=3001

# SQLite Database Path (optional, defaults to data/sonic-agent.db in apps/api).
# A relative path is resolved against apps/api, not the directory the server is started from.
# SQLITE_DB_PATH=./data/sonic-agent.db

# Retention (optional). The API prunes old data at startup and then every hour.
# Checkpoints of a thread are deleted once it has been idle this many hours (minimum 1);
# a thread waiting for the user's track choice is kept until its run is older than RUN_RETENTION_DAYS.
# CHECKPOINT_RETENTION_HOURS=24
# Stored items (cached track results) not updated for this many days are deleted (minimum 1);
# track choices under ["disambiguation"] are kept.
# STORE_RETENTION_DAYS=30
# Run records are deleted this many days after they finished, or started if they never did (minimum 1).
# RUN_RETENTION_DAYS=30
