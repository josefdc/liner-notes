# =============================================================================
# Docker Ignore - repository root context (fallback)
# The web and API images use apps/web/Dockerfile.dockerignore and
# apps/api/Dockerfile.dockerignore; this allowlist covers builders that ignore
# those files and sends only what either image needs.
# =============================================================================

**

!package.json
!package-lock.json
!.npmrc
!apps/web
!apps/api
!services/audio/package.json
!packages/contract
!fixtures/replays

**/node_modules
**/dist
**/dist-e2e*
**/.env*
**/data
**/*.db
**/*.db-*
**/*.sqlite*
**/coverage
**/*.md
**/*.log

# The contract's tests, fixtures and schema snapshots are not needed to build it
packages/contract/snapshots
packages/contract/fixtures
packages/contract/src/testing
