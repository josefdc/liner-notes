{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/node_modules", "!evals/reports", "!services/audio/**/*.py"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "javascript": {
        "formatter": {
          "quoteStyle": "single",
          "jsxQuoteStyle": "double"
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/components/ActivityLog.tsx",
        "apps/web/src/components/Dashboard.tsx",
        "apps/web/src/components/Onboarding.tsx",
        "apps/web/src/components/SmartTimeline.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noStaticElementInteractions": "off",
            "noNoninteractiveTabindex": "off",
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/api/src/agent/enricher.ts",
        "apps/api/src/agent/errors.ts",
        "apps/api/src/agent/nodes/historianNode.ts",
        "apps/api/src/sources/genius.ts",
        "apps/web/src/components/GenealogyGraph.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
