{
  "name": "@liner-notes/web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "theme": "node config/theme.mjs",
    "predev": "npm run theme && npm run build -w @liner-notes/contract",
    "dev": "vite",
    "prebuild": "npm run theme && node config/contrast.mjs src/styles/tokens.css && npm run build -w @liner-notes/contract",
    "build": "vite build",
    "prepreview": "npm run build -w @liner-notes/contract",
    "preview": "vite preview",
    "pretypecheck": "npm run build -w @liner-notes/contract",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@liner-notes/contract": "0.0.0",
    "d3-drag": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-transition": "3.0.1",
    "d3-zoom": "3.0.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-selection": "3.0.11",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.8",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.3"
  }
}
