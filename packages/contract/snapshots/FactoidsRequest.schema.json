{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "FactoidsRequest.schema.json",
    "type": "object",
    "properties": {
      "trackId": { "type": "string", "minLength": 1 },
      "trackTitle": { "type": "string", "minLength": 1 },
      "trackArtist": { "type": "string" },
      "existingFactoidIds": { "type": "array", "items": { "type": "string" } },
      "runId": {
        "description": "The analysis the factoids are for, so they do not repeat",
        "type": "string"
      },
      "round": {
        "description": "The round of facts asked for: the nextRound of the last answer, so each asks anew",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "failedIndexes": {
        "description": "With round: the indexes of the facts the last answer for that round could not write; only those angles are asked again",
        "minItems": 1,
        "type": "array",
        "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "required": ["trackId", "trackTitle"]
  },
  "output": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "FactoidsRequest.schema.json",
    "type": "object",
    "properties": {
      "trackId": { "type": "string", "minLength": 1 },
      "trackTitle": { "type": "string", "minLength": 1 },
      "trackArtist": { "type": "string" },
      "existingFactoidIds": { "type": "array", "items": { "type": "string" } },
      "runId": {
        "description": "The analysis the factoids are for, so they do not repeat",
        "type": "string"
      },
      "round": {
        "description": "The round of facts asked for: the nextRound of the last answer, so each asks anew",
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "failedIndexes": {
        "description": "With round: the indexes of the facts the last answer for that round could not write; only those angles are asked again",
        "minItems": 1,
        "type": "array",
        "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "required": ["trackId", "trackTitle"],
    "additionalProperties": false
  },
  "unknownKeys": { "$": "strip" },
  "refinements": [],
  "tolerant": []
}
