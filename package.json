{
  "name": "liner-notes",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "services/audio",
    "packages/contract"
  ],
  "scripts": {
    "dev": "npm run build -w packages/contract && exec node scripts/dev.mjs",
    "build": "npm run build -w packages/contract -w apps/web -w apps/api",
    "test:db": "npm run build -w packages/contract && vitest run --project api src/store/database.test.ts",
    "preview": "npm run preview -w apps/web",
    "typecheck": "npm run build -w packages/contract && npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tools.json",
    "test": "npm run build -w packages/contract && vitest run",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "guard:honest": "node scripts/guard-honest.mjs",
    "check:css": "node scripts/check-built-css.mjs",
    "check:release-age": "node scripts/check-release-age.mjs",
    "check:theme": "node scripts/check-theme-sync.mjs",
    "check:contrast": "node scripts/contrast.mjs apps/web/src/styles/tokens.css",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual.mjs",
    "test:visual:update": "node scripts/visual.mjs --update-snapshots=changed",
    "test:replay": "node scripts/replay-e2e.mjs && REPLAY_INTERRUPT_TEST=1 vitest run --project scripts replay-interrupt",
    "contract:check": "npm run build -w packages/contract && node packages/contract/scripts/contract-check.mjs",
    "demo:build": "node scripts/build-static-demo.mjs",
    "demo:preview": "node scripts/serve-static-demo.mjs",
    "demo:cards": "node scripts/static-demo-cards.mjs",
    "eval": "node evals/agent/eval.mjs",
    "eval:table": "node evals/agent/report.mjs"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "happy-dom": "21.0.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
