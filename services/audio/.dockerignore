# =============================================================================
# Docker Ignore - Python Audio Analysis Service
# =============================================================================

# Virtual environment (platform-specific, must be rebuilt in container)
.venv

# Local models and data (the container fetches the models when it starts)
models/
data/

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode
.idea
*.swp
*.swo

# Git
.git
.gitignore

# Build and npm files the service does not run (pyproject.toml and uv.lock stay: the build
# installs from them)
Dockerfile
.dockerignore
package.json

# Documentation
*.md

# Test files and tool caches
tests/
*.test.py
pytest.ini
.pytest_cache
.ruff_cache

# Logs
*.log

# Environment files (none of them belong in the image)
.env*
