{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 2 },
    "analyzerVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Semver of the feature contract plus model ids; part of the cache key"
    },
    "window": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "preview-30s" },
        "durationSeconds": {
          "type": "number",
          "minimum": 0,
          "description": "Length of the decoded preview"
        }
      },
      "required": ["kind", "durationSeconds"],
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "reason": {
          "anyOf": [
            { "type": "string", "enum": ["silence", "noise", "too_short"] },
            { "type": "null" }
          ],
          "description": "Set exactly when the gate did not pass"
        }
      },
      "required": ["passed", "reason"],
      "additionalProperties": false
    },
    "tempo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "bpm": { "type": "number", "exclusiveMinimum": 0 },
            "confidence": {
              "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }],
              "description": "Estimator confidence normalised to 0..1 by the audio service; null when the estimator gives none. Essentia's RhythmExtractor2013 reports 0 to 5.32: the service divides by 5.32 and clips to 0..1, and keeps the reported value in rawConfidence."
            },
            "rawConfidence": {
              "description": "The confidence as the estimator reported it, with its scale",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": { "type": "number" },
                    "range": {
                      "type": "array",
                      "prefixItems": [{ "type": "number" }, { "type": "number" }],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2,
                      "description": "The estimator's scale, e.g. [0, 5.32]"
                    }
                  },
                  "required": ["value", "range"],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "Estimator, e.g. 'essentia.RhythmExtractor2013'"
            },
            "basis": { "type": "string", "const": "signal" }
          },
          "required": ["bpm", "confidence", "method", "basis"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "key": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tonic": {
              "type": "string",
              "enum": ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"],
              "description": "Spelled with sharps; the service maps flat names (Bb -> A#)"
            },
            "mode": { "type": "string", "enum": ["major", "minor"] },
            "strength": {
              "anyOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }],
              "description": "Key strength from the estimator; null when none"
            },
            "profile": {
              "type": "string",
              "minLength": 1,
              "description": "Key profile used, e.g. 'edma' or 'krumhansl'"
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "Estimator, e.g. 'essentia.KeyExtractor'"
            },
            "basis": { "type": "string", "const": "signal" }
          },
          "required": ["tonic", "mode", "strength", "profile", "method", "basis"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "loudness": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "rmsMean": {
              "type": "number",
              "minimum": 0,
              "description": "Mean RMS amplitude, linear, full scale = 1"
            },
            "method": { "type": "string", "minLength": 1 },
            "basis": { "type": "string", "const": "signal" }
          },
          "required": ["rmsMean", "method", "basis"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "beats": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "times": {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "description": "Beat positions in seconds, ascending"
            },
            "method": { "type": "string", "minLength": 1 },
            "basis": { "type": "string", "const": "signal" }
          },
          "required": ["times", "method", "basis"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "energyContour": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hopSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "values": {
              "type": "array",
              "items": { "type": "number", "minimum": 0 },
              "description": "RMS per hop, from the start of the preview"
            },
            "method": { "type": "string", "minLength": 1 },
            "basis": { "type": "string", "const": "signal" }
          },
          "required": ["hopSeconds", "values", "method", "basis"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "sections": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "segments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Neutral label: 'A', 'B', ..."
                  },
                  "start": { "type": "number", "minimum": 0 },
                  "end": { "type": "number", "minimum": 0 }
                },
                "required": ["label", "start", "end"],
                "additionalProperties": false
              }
            },
            "method": { "type": "string", "minLength": 1 },
            "basis": { "type": "string", "const": "signal" }
          },
          "required": ["segments", "method", "basis"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "keyMoments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds from the start of the preview"
          },
          "type": {
            "type": "string",
            "enum": ["energy_peak", "energy_drop", "onset", "harmonic_change", "silence"]
          },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "description": { "type": "string" }
        },
        "required": ["time", "type", "intensity", "description"],
        "additionalProperties": false
      }
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "styles": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                        },
                        "licence": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                        }
                      },
                      "required": ["id", "licence"],
                      "additionalProperties": false
                    },
                    "top": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string", "minLength": 1 },
                          "score": {
                            "type": "number",
                            "description": "Model activation; a score, not a probability"
                          }
                        },
                        "required": ["label", "score"],
                        "additionalProperties": false
                      }
                    },
                    "basis": { "type": "string", "const": "model" }
                  },
                  "required": ["model", "top", "basis"],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "tags": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                        },
                        "licence": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                        }
                      },
                      "required": ["id", "licence"],
                      "additionalProperties": false
                    },
                    "scores": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": { "type": "string", "minLength": 1 },
                          "score": {
                            "type": "number",
                            "description": "Model activation; a score, not a probability"
                          }
                        },
                        "required": ["label", "score"],
                        "additionalProperties": false
                      }
                    },
                    "basis": { "type": "string", "const": "model" }
                  },
                  "required": ["model", "scores", "basis"],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            },
            "moods": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "danceability": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "value": { "type": "number" },
                            "range": {
                              "type": "array",
                              "prefixItems": [{ "type": "number" }, { "type": "number" }],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2,
                              "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal"
                            },
                            "model": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                                },
                                "licence": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                                }
                              },
                              "required": ["id", "licence"],
                              "additionalProperties": false
                            },
                            "basis": { "type": "string", "const": "model" }
                          },
                          "required": ["value", "range", "model", "basis"],
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ]
                    },
                    "acoustic": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "value": { "type": "number" },
                            "range": {
                              "type": "array",
                              "prefixItems": [{ "type": "number" }, { "type": "number" }],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2,
                              "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal"
                            },
                            "model": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                                },
                                "licence": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                                }
                              },
                              "required": ["id", "licence"],
                              "additionalProperties": false
                            },
                            "basis": { "type": "string", "const": "model" }
                          },
                          "required": ["value", "range", "model", "basis"],
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ]
                    },
                    "instrumental": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "value": { "type": "number" },
                            "range": {
                              "type": "array",
                              "prefixItems": [{ "type": "number" }, { "type": "number" }],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2,
                              "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal"
                            },
                            "model": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                                },
                                "licence": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                                }
                              },
                              "required": ["id", "licence"],
                              "additionalProperties": false
                            },
                            "basis": { "type": "string", "const": "model" }
                          },
                          "required": ["value", "range", "model", "basis"],
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ],
                      "description": "Voice/instrumental head: the instrumental output"
                    },
                    "valence": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "value": { "type": "number" },
                            "range": {
                              "type": "array",
                              "prefixItems": [{ "type": "number" }, { "type": "number" }],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2,
                              "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal"
                            },
                            "model": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                                },
                                "licence": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                                }
                              },
                              "required": ["id", "licence"],
                              "additionalProperties": false
                            },
                            "basis": { "type": "string", "const": "model" }
                          },
                          "required": ["value", "range", "model", "basis"],
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ]
                    },
                    "arousal": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "value": { "type": "number" },
                            "range": {
                              "type": "array",
                              "prefixItems": [{ "type": "number" }, { "type": "number" }],
                              "items": false,
                              "minItems": 2,
                              "maxItems": 2,
                              "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal"
                            },
                            "model": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Model id, e.g. 'discogs-effnet-bs64-1'"
                                },
                                "licence": {
                                  "type": "string",
                                  "minLength": 1,
                                  "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'"
                                }
                              },
                              "required": ["id", "licence"],
                              "additionalProperties": false
                            },
                            "basis": { "type": "string", "const": "model" }
                          },
                          "required": ["value", "range", "model", "basis"],
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": ["danceability", "acoustic", "instrumental", "valence", "arousal"],
                  "additionalProperties": false
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["styles", "tags", "moods"],
          "additionalProperties": false
        },
        { "type": "null" }
      ],
      "description": "null when the models are not loaded"
    },
    "withheld": {
      "description": "Why each null value is null (analyzer 2.3.0 and later)",
      "type": "object",
      "properties": {
        "tempo": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "gate_silence",
                "gate_noise",
                "gate_too_short",
                "no_beat",
                "tempo_out_of_range",
                "too_few_beats",
                "low_confidence",
