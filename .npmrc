# Only the install scripts listed under "allowScripts" in package.json may run;
# npm refuses any other (including a new version of a listed package) until it
# is reviewed and approved with `npm install-scripts approve <pkg>`. This also
# applies to npx inside the repository (use --allow-scripts=<pkg> for one-offs).
# Enforced by npm >= 11.18; older npm (e.g. npm 10) ignores the setting.
strict-allow-scripts=true

# Refuses to install on a Node.js that the project's or a dependency's "engines" excludes
# (the project needs Node.js 24 or later).
engine-strict=true

# Resolves only package releases at least 14 days old (a rolling window, as `exclude-newer` in
# the audio service's uv settings). Versions already in package-lock.json are not checked again.
min-release-age=14
