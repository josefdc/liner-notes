# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Google Gemini API Key (for LLM)
# Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key (for web search)
# Get from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# NEW TOOL INTEGRATIONS
# =============================================================================

# User-Agent sent to MusicBrainz and the other record sources (optional). The default names the
# app and its repository. Set it to identify your own deployment, as AppName/Version ( contact ),
# where contact is a URL or an email address. MUSICBRAINZ_USER_AGENT is read when it is not set.
# SOURCE_USER_AGENT=

# Last.fm API Key (strongly recommended — enriches genre profile and discovery)
# Get from https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Primary-record sources (optional). A source without its credential is reported as missing;
# nothing is guessed in its place. Each credential is sent in a request header, never in a URL.
# Discogs personal access token (https://www.discogs.com/settings/developers), sent as
# "Authorization: Discogs token=...". Used for release credits.
# DISCOGS_TOKEN=
# SecondHandSongs API key, sent as "X-API-Key". Optional: without it requests are anonymous and
# limited to a lower rate.
# SHS_API_KEY=
# Genius client access token (https://genius.com/api-clients), sent as "Authorization: Bearer ...".
# Only song relationships (samples, covers, remixes) are read; lyrics are never requested.
# GENIUS_ACCESS_TOKEN=

# Audio Analysis Microservice URL
# Run: cd services/audio && uvicorn main:app --port 3002
AUDIO_ANALYSIS_URL=http://localhost:3002

# Server Configuration
PORT=3001
# Address to bind. The default 127.0.0.1 keeps the API off the network; containers set 0.0.0.0.
# HOST=127.0.0.1

# Replay mode (optional): "only" or "off" (default). With REPLAY_MODE=only the startup check
# requires no Spotify or model keys.
# REPLAY_MODE=only

# Browser origins allowed to call the API (CORS), comma-separated, each scheme://host[:port].
# Unset in development: the web dev ports 3000, 3100, 3110, 3120, ..., 3190 (the worktree slots,
# not the range between them), 4173 and WEB_PORT, each on localhost and 127.0.0.1.
# Write an origin as the browser sends it: no path, no trailing slash, no default port (:80, :443).
# Unset in production: none. Set but empty: none, with a warning at startup.
# Docker Compose sets CORS_ORIGINS itself (its `environment:` overrides this file): from the shell
# that runs it, default http://localhost,http://127.0.0.1 (its web app).
# Paid routes (analysis, factoids, search) also refuse requests from unlisted origins and
# cross-site requests with no Origin (403 forbidden_origin; in the stream for event streams).
# CORS_ORIGINS=http://localhost:3000,https://liner-notes.example

# Reverse proxies in front of the API whose X-Forwarded-For is trusted for the client address
# (the rate-limit key). 0 (default) when clients connect directly; 1 behind one proxy.
# TRUST_PROXY=0

# Rate limits. Analysis and factoids (paid model calls) share a per-IP limit and a limit across
# all clients over the same window; search has its own per-IP limit.
# RATE_LIMIT_WINDOW_MS=600000
# RATE_LIMIT_MAX=30
# RATE_LIMIT_GLOBAL_MAX=300
# SEARCH_RATE_LIMIT_WINDOW_MS=60000
# SEARCH_RATE_LIMIT_MAX=60

# SQLite Database Path (optional, defaults to data/sonic-agent.db in apps/api).
# Run one API process per database file: at startup and shutdown a process records the runs
# still marked running as ended, taking them to be its own.
# A relative path is resolved against apps/api, not the directory the server is started from.
# SQLITE_DB_PATH=./data/sonic-agent.db

# Retention (optional). The API prunes old data at startup and then every hour.
# Checkpoints of a thread are deleted once it has been idle this many hours (minimum 1);
# a thread waiting for the user's track choice is kept until its run is older than RUN_RETENTION_DAYS.
# CHECKPOINT_RETENTION_HOURS=24
# Stored items (cached track results) not updated for this many days are deleted (minimum 1);
# track choices under ["disambiguation"] are kept.
# STORE_RETENTION_DAYS=30
# Run records are deleted this many days after they finished, or started if they never did (minimum 1).
# RUN_RETENTION_DAYS=30
