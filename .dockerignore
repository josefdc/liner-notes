# =============================================================================
# Docker Ignore - repository root context (fallback)
# The web and API images use apps/web/Dockerfile.dockerignore and
# apps/api/Dockerfile.dockerignore; this file covers builders that ignore those.
# =============================================================================

.git
**/node_modules
**/dist
**/.env
**/.env.local
**/data
**/*.db
**/*.db-*
**/.venv
**/__pycache__
services/audio/models
**/*.log
