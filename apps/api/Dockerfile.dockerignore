# =============================================================================
# Docker Ignore - API build (context: repository root, Dockerfile: apps/api/Dockerfile)
# Allowlist: only the root manifests, the workspace manifests and the API.
# =============================================================================

**

!package.json
!package-lock.json
!apps/api
!apps/web/package.json
!services/audio/package.json
!packages/contract

# Never send these, even inside allowed directories (env comes from compose env_file)
**/node_modules
**/dist
**/.env*
**/data
**/*.db
**/*.db-*
**/*.sqlite*
coverage
**/coverage
**/*.md
**/*.test.ts
**/*.spec.ts
**/__tests__
**/*.log

# The contract's tests, fixtures and schema snapshots are not needed to build it
packages/contract/snapshots
packages/contract/fixtures
packages/contract/src/testing
