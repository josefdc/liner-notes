# Web app build settings (Vite reads them from the environment or from apps/web/.env*).
# Values are compiled into the bundle, so never put a secret here.

# The API's root URL, including its /api prefix: a path on the web app's own origin, or an
# absolute URL when the API is served from another origin (that origin must then be listed in
# the API's CORS_ORIGINS). A trailing slash is ignored.
# Unset: /api on the web app's origin. `npm run dev` and `vite preview` forward /api to the
# local API (port 3001, or API_PORT); the web image is built with /api and nginx forwards it.
# VITE_API_URL=https://api.example.com/api
