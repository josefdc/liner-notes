{
  "name": "@liner-notes/api",
  "version": "0.1.0",
  "description": "LangGraph backend for The Sonic Agent",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test:spotify": "tsx src/sources/spotify.test.ts",
    "test:agent": "tsx src/agent/graph.test.ts",
    "test:tools": "tsx src/sources/genius.test.ts && tsx src/sources/musicbrainz.test.ts",
    "test:lastfm": "tsx src/sources/lastfm.test.ts",
    "test:listenbrainz": "tsx src/sources/listenbrainz.test.ts",
    "test:db": "tsx src/store/database.test.ts",
    "build": "tsup",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "1.34.0",
    "@langchain/community": "1.1.17",
    "@langchain/core": "1.1.27",
    "@langchain/langgraph": "1.1.5",
    "@langchain/langgraph-checkpoint": "1.0.0",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.1",
    "@langchain/tavily": "1.2.0",
    "better-sqlite3": "12.10.0",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.25",
    "@types/node": "22.19.3",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
