                                  "licence": {
                                    "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'",
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": ["id", "licence"]
                              },
                              "basis": { "type": "string", "const": "model" }
                            },
                            "required": ["value", "range", "model", "basis"]
                          },
                          { "type": "null" }
                        ]
                      },
                      "valence": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "value": { "type": "number" },
                              "range": {
                                "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal",
                                "type": "array",
                                "prefixItems": [{ "type": "number" }, { "type": "number" }],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              },
                              "model": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "description": "Model id, e.g. 'discogs-effnet-bs64-1'",
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "licence": {
                                    "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'",
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": ["id", "licence"]
                              },
                              "basis": { "type": "string", "const": "model" }
                            },
                            "required": ["value", "range", "model", "basis"]
                          },
                          { "type": "null" }
                        ]
                      },
                      "arousal": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "value": { "type": "number" },
                              "range": {
                                "description": "Output range of the head, e.g. [0, 1], or [1, 9] for DEAM valence and arousal",
                                "type": "array",
                                "prefixItems": [{ "type": "number" }, { "type": "number" }],
                                "items": false,
                                "minItems": 2,
                                "maxItems": 2
                              },
                              "model": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "description": "Model id, e.g. 'discogs-effnet-bs64-1'",
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "licence": {
                                    "description": "Licence of the model weights, e.g. 'CC BY-NC-SA 4.0'",
                                    "type": "string",
