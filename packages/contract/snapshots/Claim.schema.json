{
  "input": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "Claim.schema.json",
    "type": "object",
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "text": { "type": "string" },
      "about": {
        "type": "string",
        "enum": [
          "track",
          "credit",
          "sample",
          "cover",
          "history",
          "sound",
          "production",
          "connection",
          "trivia"
        ]
      },
      "kind": { "type": "string", "enum": ["measured", "sourced", "inferred"] },
      "origin": { "type": "string", "enum": ["code", "model"] },
      "evidenceIds": { "type": "array", "items": { "type": "string" } },
      "verdict": {
        "anyOf": [
          { "type": "string", "enum": ["supported", "partial", "unsupported", "contradicted"] },
          { "type": "null" }
        ],
        "description": "null: not judged (e.g. beyond the 20-claim judge batch)"
      },
      "verdictReason": {
        "description": "Why the judge gave its verdict",
        "type": ["string", "null"]
      },
      "numericCheck": {
        "type": "string",
        "enum": ["consistent", "conflict", "contradicted", "n/a"]
      },
      "numericReason": {
        "description": "Why the numeric check gave its result; separate from the judge's reason",
        "type": ["string", "null"]
      },
      "numericComparison": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "claimed": {
                "description": "The value the claim states",
                "type": ["number", "string"]
              },
              "measured": { "description": "The measured value", "type": ["number", "string"] },
              "method": {
                "type": "string",
                "description": "How it was measured, e.g. 'essentia.RhythmExtractor2013'"
              }
            },
            "required": ["claimed", "measured", "method"]
          },
          { "type": "null" }
        ]
      },
      "field": { "type": "string", "enum": ["tempo", "key"] },
      "scope": {
        "description": "What the claim states a fact about: this recording, the song (work) or a whole release; absent on older claims",
        "type": "string",
        "enum": ["recording", "work", "release"]
      },
      "factoid": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["production", "trivia", "credits", "sample", "curiosity", "connection"]
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["synth", "producer", "sample", "technique", "artist", "album", "year"]
                }
              },
              "required": ["text", "type"]
            }
          }
        },
        "required": ["title", "type", "entities"]
      },
      "documentedBy": {
        "description": "On a model claim about a sample or a cover: the code-built claims, each on a record it cites, whose relation it states plainly and only, in the record's direction. Readers name its relation as theirs; its own kind and verdict are unchanged. Absent: no record documents it, or the claim's words do not plainly state it",
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": [
      "id",
      "text",
      "about",
      "kind",
      "origin",
      "evidenceIds",
      "verdict",
      "verdictReason",
      "numericCheck"
    ]
  },
  "output": {
