{
  "name": "@liner-notes/api",
  "private": true,
  "version": "0.1.0",
  "description": "LangGraph backend for Liner Notes",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @liner-notes/contract",
    "dev": "tsx watch src/index.ts",
    "prestart": "npm run build -w @liner-notes/contract",
    "start": "node --import tsx src/index.ts",
    "pretest:db": "npm run build -w @liner-notes/contract",
    "test:db": "vitest run --root ../.. --project api src/store/database.test.ts",
    "pretest:lastfm": "npm run build -w @liner-notes/contract",
    "test:lastfm": "vitest run --root ../.. --project api src/sources/lastfm.test.ts",
    "prebuild": "npm run build -w @liner-notes/contract",
    "build": "tsup",
    "start:prod": "node dist/index.js",
    "pretypecheck": "npm run build -w @liner-notes/contract",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build -w @liner-notes/contract",
    "test": "vitest run --root ../.. --project api",
    "prereplay:record": "npm run build -w @liner-notes/contract",
    "replay:record": "tsx src/replay/record.ts",
    "presmoke:llm": "npm run build -w @liner-notes/contract",
    "smoke:llm": "tsx src/scripts/smokeLlm.ts",
    "prereport": "npm run build -w @liner-notes/contract",
    "report": "tsx src/scripts/report.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint": "1.2.0",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.0",
    "@langchain/tavily": "1.2.0",
    "@liner-notes/contract": "0.0.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "openai": "7.30.0",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
